# All optional: with nothing set, QuickChat runs in demo mode (in-memory data + mock AI).
PORT=5000
CLIENT_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
# Persistence (free: MongoDB Atlas M0). Empty => in-memory store with seeded demo data.
MONGODB_URI=
# Image hosting (free: Cloudinary). Empty => images stored inline as data URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# AI provider: auto | gemini | groq | mock. "auto" picks the first key present, else mock.
AI_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEY=
